{
  "name": "dsh-notify-windows",
  "version": "0.7.6",
  "description": "DeepSeek Harness (DSH) 插件：任务完成 / 等待审批 / 等待回答时发送 Windows 系统桌面通知",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SeverusZh/dsh-notify-windows.git"
  },
  "homepage": "https://github.com/SeverusZh/dsh-notify-windows",
  "bugs": {
    "url": "https://github.com/SeverusZh/dsh-notify-windows/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "CHANGELOG.md"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\""
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dshReleases": {
        "0.1.5-rc.1": "compatible",
        "0.1.5-rc.2": "compatible",
        "0.1.6-alpha.2": "compatible"
      },
      "node": ">=20"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "notify",
    "toast",
    "windows"
  ]
}
